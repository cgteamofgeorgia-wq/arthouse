# ── Supabase ────────────────────────────────────────────────────────────
# Settings → API → Project URL / anon public / service_role
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# აპლიკაციის მისამართი — სწორედ აქ ბრუნდება გადახდის webhook.
# localhost არ გამოდგება: პროვაიდერს საჯარო HTTPS სჭირდება.
# დომენით ტესტვისას: https://test.yourdomain.ge ან ngrok-ის მისამართი.
APP_URL=http://localhost:3000

# ── ძებნა ───────────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# ── გადახდის პროვაიდერები (TD 5.3) ──────────────────────────────────────
# webhook-ის ხელმოწერის გასაღებები — იგივე მნიშვნელობა, რასაც პროვაიდერი გამოგიგზავნით
PAYMENT_SECRET_PAYZE=
PAYMENT_SECRET_TBC=
PAYMENT_SECRET_BOG=
PAYMENT_SECRET_STRIPE=
STRIPE_SECRET_KEY=

# ── ელფოსტა (Resend ან SendGrid) ────────────────────────────────────────
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=BuildHub <noreply@buildhub.ge>

# ── SMS — ლოკალური პროვაიდერი ───────────────────────────────────────────
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=BuildHub

# ── push ────────────────────────────────────────────────────────────────
FCM_SERVER_KEY=

# ── უსაფრთხოება ─────────────────────────────────────────────────────────
CODE_PEPPER=
CRON_SECRET=

# ── ანალიტიკა ───────────────────────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=
